# Settings for the public server. deploy/server-deploy.sh copies this to /srv/cheatscanner/.env on the first
# deploy and fills in every GENERATE value with a random secret. Fill in the rest by hand
# (ssh deploy@<server>, then: nano /srv/cheatscanner/.env). Never commit the real file.

# Makes a plain `docker compose ...` on the server use the production setup and start the demo fetcher.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=fetch
CS2A_DOMAIN=cheatscanner.eu
CS2A_PUBLIC_URL=https://cheatscanner.eu

POSTGRES_USER=cs2
POSTGRES_PASSWORD=GENERATE
POSTGRES_DB=cs2

CS2A_AUTH_ENABLED=1
CS2A_REQUIRE_MATCH_ACCESS=1
# Encrypts users' Steam authentication codes. If you copy your local database to the server, use the
# CS2A_SECRET_KEY from your PC's .env instead, or everyone has to enter their code again.
CS2A_SECRET_KEY=GENERATE
CS2A_SERVICE_TOKEN=GENERATE

# Fill in:
# Your SteamID64 (comma-separated for more people) for the Admin page.
CS2A_ADMIN_STEAM_IDS=
# https://steamcommunity.com/dev/apikey (register it for the domain cheatscanner.eu)
CS2A_STEAM_API_KEY=
# Shown on the privacy page for data requests. Needed before the site opens to the public.
CS2A_CONTACT_EMAIL=
# The dedicated Steam bot account (never your main account).
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=

CS2A_MAX_UPLOAD_MB=1000
CS2A_MAX_PARALLEL_UPLOADS=1
CS2A_MAX_UPLOADS_PER_DAY=10
CS2A_MAX_QUEUED_UPLOADS=3
CS2A_MIN_FREE_DISK_GB=20
# Analysis workers (separate containers). 2 fits a CX33 (4 vCPU, 8 GB); see "Analysis workers" in
# docs/deploy/hetzner.md before raising it.
CS2A_WORKERS=2
# Workers that render evidence clips first (0: the analysis workers render them while no demo waits).
# Each needs as much CPU and RAM as an analysis worker. On a CX33 e.g. CS2A_WORKERS=2 and CS2A_CLIP_WORKERS=2.
CS2A_CLIP_WORKERS=0
# 0: evidence clips only for players rated Elevated or High in that match (default: also the strongest events
# of Normal players). Applies to clips already waiting too.
CS2A_CLIP_ALL_EVENTS=1
# 0: no separate clips jobs; clips are rendered inside the analysis and the demo is deleted right after (results
# then appear only once the clips are done). Also happens by itself while less than 30 GB of disk is free.
CS2A_DEFER_CLIPS=1

# Backups (deploy/backup.sh, every night at 03:17). Without BORG_REPO only local database dumps are kept.
# Storage Box example: ssh://u123456@u123456.your-storagebox.de:23/./cheatscanner
BORG_REPO=
# Keep a copy of this passphrase outside the server (password manager): without it the backups can't be read.
BORG_PASSPHRASE=GENERATE
# Optional heartbeat URL (e.g. a free healthchecks.io check). Pinged after each backup; /fail when the
# backup fails or free disk space is below 30 GB, so you get an email.
HEALTHCHECK_URL=
