# HTTPS in front of the API. Caddy gets and renews the Let's Encrypt certificate by itself.
{$CS2A_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy api:8000
}

www.{$CS2A_DOMAIN} {
	redir https://{$CS2A_DOMAIN}{uri} permanent
}
