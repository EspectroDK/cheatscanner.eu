POSTGRES_USER=cs2
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cs2

# Steam sign-in for the website/API (off by default for local use).
CS2A_AUTH_ENABLED=0
# The address people use to reach the site. On the public server: https://cheatscanner.eu
CS2A_PUBLIC_URL=http://localhost:8000
# Steam IDs (SteamID64, comma-separated) that may open the Admin page, e.g. your own.
CS2A_ADMIN_STEAM_IDS=
# Optional, only for showing names/avatars: https://steamcommunity.com/dev/apikey
CS2A_STEAM_API_KEY=
# Required when sign-in is on and for automatic demo fetching (1 = users must connect their match history).
CS2A_REQUIRE_MATCH_ACCESS=1
# Encrypts users' Steam authentication codes. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it means every user has to enter their code again.
CS2A_SECRET_KEY=
# Largest demo the website accepts as an upload, in MB.
CS2A_MAX_UPLOAD_MB=1000
# Per-user upload limits (automatically fetched matches don't count), and the free disk space below
# which all uploads are refused.
CS2A_MAX_PARALLEL_UPLOADS=1
CS2A_MAX_UPLOADS_PER_DAY=10
CS2A_MAX_QUEUED_UPLOADS=3
CS2A_MIN_FREE_DISK_GB=20
# Shown on the privacy page as the address for data requests (what is stored, disputes, removal).
CS2A_CONTACT_EMAIL=
# Shared secret between the API and the demo fetcher (any long random string).
CS2A_SERVICE_TOKEN=

# Demo fetcher: a dedicated Steam account that owns CS2 (never your main account).
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# Optional: the account's mobile authenticator shared_secret, for unattended logins.
STEAM_BOT_SHARED_SECRET=
